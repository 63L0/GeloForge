{
  "name": "geloforge",
  "version": "0.10.0",
  "description": "Zero-dependency local CLI & MCP server for AI coding agents — shared project memory, verified test evidence, skill advisor, MCP tool pinning, and cross-agent handoffs.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/63L0/GeloForge.git"
  },
  "homepage": "https://github.com/63L0/GeloForge#readme",
  "bugs": {
    "url": "https://github.com/63L0/GeloForge/issues"
  },
  "keywords": [
    "ai-coding",
    "ai-harness",
    "mcp",
    "mcp-server",
    "agent-skills",
    "coding-agent",
    "claude-code",
    "cursor",
    "codex",
    "gemini-cli",
    "context-engineering",
    "project-memory",
    "cross-agent-handoff",
    "zero-dependency",
    "developer-tools"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "geloforge": "./scripts/geloforge.mjs"
  },
  "files": [
    "core/",
    "adapters/n8n/staging-audit-error-workflow.json",
    "policies/",
    "schemas/",
    "scripts/bootstrap-project.mjs",
    "scripts/geloforge.mjs",
    "templates/",
    "THIRD_PARTY_NOTICES.md",
    "VERSION"
  ],
  "scripts": {
    "test": "node --test",
    "validate": "node --test",
    "validate:project": "node scripts/validate-project.mjs",
    "bootstrap": "node scripts/bootstrap-project.mjs",
    "geloforge": "node scripts/geloforge.mjs",
    "benchmark": "node scripts/benchmark-context.mjs",
    "eval": "node scripts/run-evals.mjs",
    "smoke:package": "node scripts/smoke-fresh-install.mjs --packed",
    "benchmark:cache": "node scripts/benchmark-context-cache.mjs",
    "benchmark:audits": "node --test tests/staging-audit-worker.test.mjs"
  }
}
