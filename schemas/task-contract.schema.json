{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workspace.local/schemas/task-contract.schema.json",
  "title": "Task Contract",
  "description": "Operational contract defining task scope, inputs, outputs, and acceptance criteria.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "project_id",
    "status",
    "memory_layer",
    "authority_level",
    "priority",
    "assigned_role",
    "created_by",
    "created_at",
    "updated_at",
    "objective",
    "scope_in",
    "scope_out",
    "required_inputs",
    "expected_outputs",
    "acceptance_criteria",
    "dependencies",
    "approval_required",
    "approval_ref",
    "context_budget",
    "max_retries",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "id": { "type": "string", "pattern": "^TASK-\\d{4}$" },
    "title": { "type": "string", "minLength": 3 },
    "project_id": { "type": "string", "pattern": "^proj-[a-z0-9][a-z0-9-]{1,48}[a-z0-9]$" },
    "status": { "type": "string", "enum": ["inbox", "ready", "active", "in_review", "blocked", "completed", "cancelled"] },
    "memory_layer": { "type": "string", "enum": ["L2_OPERATIONAL"] },
    "authority_level": { "type": "string", "enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A6"] },
    "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "assigned_role": {
      "type": "string",
      "enum": ["orchestrator", "researcher", "software-architect", "developer", "qa-security-reviewer"]
    },
    "created_by": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 10 },
    "updated_at": { "type": "string", "minLength": 10 },
    "objective": { "type": "string", "minLength": 1 },
    "scope_in": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "scope_out": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "required_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "revision"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "revision": { "type": "string", "minLength": 1 }
        }
      }
    },
    "expected_outputs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "pattern": "^TASK-\\d{4}$" }
    },
    "approval_required": { "type": "boolean" },
    "approval_ref": { "type": ["string", "null"], "pattern": "^APPR-\\d{4}$" },
    "context_budget": { "type": "string", "enum": ["quick", "working", "deep"] },
    "max_retries": { "type": "integer", "minimum": 0, "maximum": 5 },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^EVID-\\d{4}$" }
    },
    "is_example": { "type": "boolean" },
    "example_notice": { "type": "string" }
  }
}
