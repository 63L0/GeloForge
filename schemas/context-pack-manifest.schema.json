{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workspace.local/schemas/context-pack-manifest.schema.json",
  "title": "Context Pack Manifest",
  "description": "Manifest produced by the future deterministic Context Compiler for Layer 4 packets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "task_id",
    "project_id",
    "status",
    "memory_layer",
    "authority_level",
    "profile",
    "token_budget_target",
    "estimated_tokens",
    "compiled_at",
    "expires_at",
    "compiler_version",
    "included_documents",
    "omitted_candidates",
    "freshness_warnings",
    "unresolved_conflicts",
    "cache_key",
    "invalidation_triggers"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0", "1.1"] },
    "id": { "type": "string", "pattern": "^CPACK-\\d{4}$" },
    "task_id": { "type": ["string", "null"], "pattern": "^TASK-\\d{4}$" },
    "query": { "type": ["string", "null"] },
    "project_id": { "type": "string", "pattern": "^proj-[a-z0-9][a-z0-9-]{1,48}[a-z0-9]$" },
    "status": { "type": "string", "enum": ["compiled", "cached", "stale", "invalidated"] },
    "memory_layer": { "type": "string", "enum": ["L4_TEMPORARY_CONTEXT"] },
    "authority_level": { "type": "string", "enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A6"] },
    "profile": { "type": "string", "enum": ["quick", "working", "deep"] },
    "effective_profile": { "type": "string", "enum": ["quick", "working", "deep"] },
    "token_budget_target": { "type": "integer", "minimum": 1 },
    "estimated_tokens": { "type": "integer", "minimum": 0 },
    "token_estimate_method": { "type": "string", "minLength": 1 },
    "budget_overrun": { "type": "boolean" },
    "budget_breakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mandatory_tokens",
        "policy_tokens",
        "project_mandatory_tokens",
        "optional_tokens",
        "codebase_map_tokens",
        "overhead_tokens"
      ],
      "properties": {
        "mandatory_tokens": { "type": "integer", "minimum": 0 },
        "policy_tokens": { "type": "integer", "minimum": 0 },
        "project_mandatory_tokens": { "type": "integer", "minimum": 0 },
        "optional_tokens": { "type": "integer", "minimum": 0 },
        "codebase_map_tokens": { "type": "integer", "minimum": 0 },
        "skills_tokens": { "type": "integer", "minimum": 0 },
        "overhead_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "codebase_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "selected_files",
        "total_discovered_files",
        "estimated_tokens"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "selected_files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "total_discovered_files": { "type": "integer", "minimum": 0 },
        "estimated_tokens": { "type": "integer", "minimum": 0 },
        "map_budget": { "type": "integer", "minimum": 0 },
        "truncated_scan": { "type": "boolean" },
        "scan_mode": { "type": "string", "minLength": 1 }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "ranking_method",
        "discovered_count",
        "indexed_count",
        "selected_skills",
        "estimated_tokens"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "ranking_method": { "type": "string", "minLength": 1 },
        "discovered_count": { "type": "integer", "minimum": 0 },
        "indexed_count": { "type": "integer", "minimum": 0 },
        "pinned_skills": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "selected_skills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "source", "tier", "reason"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 },
              "tier": { "type": "string", "enum": ["tier0", "tier1", "tier1+tier2"] },
              "score": { "type": "integer", "minimum": 0 },
              "reason": { "type": "string", "minLength": 1 },
              "supporting_resources": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "omitted_skills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "reason"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "quarantined_excluded": { "type": "integer", "minimum": 0 },
        "security_flagged_excluded": { "type": "integer", "minimum": 0 },
        "estimated_tokens": { "type": "integer", "minimum": 0 },
        "skills_budget": { "type": "integer", "minimum": 0 }
      }
    },
    "compiled_at": { "type": "string", "minLength": 10 },
    "expires_at": { "type": ["string", "null"] },
    "compiler_version": { "type": "string", "minLength": 1 },
    "included_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "memory_layer", "authority_level", "revision", "reason", "mandatory"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "memory_layer": {
            "type": "string",
            "enum": ["L1_AUTHORITATIVE", "L2_OPERATIONAL", "L3_RESEARCH_EVIDENCE", "L4_TEMPORARY_CONTEXT"]
          },
          "authority_level": { "type": "string", "enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A6"] },
          "revision": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "mandatory": { "type": "boolean" }
        }
      }
    },
    "omitted_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "freshness_warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "unresolved_conflicts": {
      "type": "array",
      "items": { "type": "string", "pattern": "^CONF-\\d{4}$" }
    },
    "cache_key": { "type": "string", "minLength": 1 },
    "invalidation_triggers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "is_example": { "type": "boolean" },
    "example_notice": { "type": "string" }
  }
}
