{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workspace.local/schemas/project-state.schema.json",
  "title": "Project State",
  "description": "Operational snapshot of project state in brain/state/current.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "state_revision",
    "status",
    "memory_layer",
    "authority_level",
    "updated_at",
    "updated_by",
    "current_phase",
    "active_tasks",
    "blocked_tasks",
    "pending_approvals",
    "open_conflicts",
    "last_verified_evidence",
    "last_checkpoint",
    "known_dependencies",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "project_id": { "type": "string", "pattern": "^proj-[a-z0-9][a-z0-9-]{1,48}[a-z0-9]$" },
    "state_revision": { "type": "integer", "minimum": 0 },
    "status": { "type": "string", "enum": ["initialized", "active", "blocked", "paused", "archived"] },
    "memory_layer": { "type": "string", "enum": ["L2_OPERATIONAL"] },
    "authority_level": { "type": "string", "enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A6"] },
    "updated_at": { "type": "string", "minLength": 10 },
    "updated_by": { "type": "string", "minLength": 1 },
    "current_phase": { "type": "string", "minLength": 1 },
    "active_tasks": {
      "type": "array",
      "items": { "type": "string", "pattern": "^TASK-\\d{4}$" }
    },
    "blocked_tasks": {
      "type": "array",
      "items": { "type": "string", "pattern": "^TASK-\\d{4}$" }
    },
    "pending_approvals": {
      "type": "array",
      "items": { "type": "string", "pattern": "^APPR-\\d{4}$" }
    },
    "open_conflicts": {
      "type": "array",
      "items": { "type": "string", "pattern": "^CONF-\\d{4}$" }
    },
    "last_verified_evidence": { "type": ["string", "null"], "pattern": "^EVID-\\d{4}$" },
    "last_checkpoint": { "type": ["string", "null"], "pattern": "^CHKPT-\\d{4}$" },
    "known_dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "summary": { "type": "string", "minLength": 1 },
    "is_example": { "type": "boolean" },
    "example_notice": { "type": "string" }
  }
}
