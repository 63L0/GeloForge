{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workspace.local/schemas/evidence-manifest.schema.json",
  "title": "Evidence Manifest",
  "description": "Verification and test evidence manifest for a task.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "task_id",
    "status",
    "memory_layer",
    "authority_level",
    "produced_by_role",
    "verified_by",
    "created_at",
    "source_revision",
    "environment",
    "checks",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0", "1.1"] },
    "id": { "type": "string", "pattern": "^EVID-\\d{4}$" },
    "title": { "type": "string", "minLength": 3 },
    "task_id": { "type": "string", "pattern": "^TASK-\\d{4}$" },
    "status": { "type": "string", "enum": ["draft", "proposed", "verified", "invalidated", "expired"] },
    "memory_layer": { "type": "string", "enum": ["L3_RESEARCH_EVIDENCE"] },
    "authority_level": { "type": "string", "enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A6"] },
    "produced_by_role": {
      "type": "string",
      "enum": ["orchestrator", "researcher", "software-architect", "developer", "qa-security-reviewer"]
    },
    "verified_by": { "type": ["string", "null"] },
    "created_at": { "type": "string", "minLength": 10 },
    "source_revision": { "type": "string", "minLength": 1 },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "runtime"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command", "result", "summary"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "result": { "type": "string", "enum": ["passed", "failed", "skipped", "not_tested", "blocked"] },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "description", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "sha256": { "type": ["string", "null"] }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "is_example": { "type": "boolean" },
    "example_notice": { "type": "string" }
  }
}
