{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workspace.local/schemas/agent-handoff.schema.json",
  "title": "Agent Handoff",
  "description": "Compact structured handoff between agent roles for a specific task.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "task_id",
    "from_role",
    "to_role",
    "status",
    "memory_layer",
    "authority_level",
    "created_at",
    "summary",
    "completed_items",
    "open_items",
    "artifacts_produced",
    "evidence_refs",
    "unresolved_risks",
    "conflicts_detected",
    "recommended_next_action",
    "context_pack_ref"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0", "1.1"] },
    "id": { "type": "string", "pattern": "^HANDOFF-\\d{4}$" },
    "task_id": { "type": ["string", "null"], "pattern": "^TASK-\\d{4}$" },
    "from_role": {
      "type": "string",
      "enum": ["orchestrator", "researcher", "software-architect", "developer", "qa-security-reviewer"]
    },
    "to_role": {
      "type": "string",
      "enum": ["orchestrator", "researcher", "software-architect", "developer", "qa-security-reviewer"]
    },
    "from_tool": { "type": ["string", "null"] },
    "to_tool": { "type": ["string", "null"] },
    "status": { "type": "string", "enum": ["draft", "submitted", "acknowledged", "rejected", "superseded"] },
    "memory_layer": { "type": "string", "enum": ["L2_OPERATIONAL"] },
    "authority_level": { "type": "string", "enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A6"] },
    "created_at": { "type": "string", "minLength": 10 },
    "summary": { "type": "string", "minLength": 1 },
    "completed_items": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "open_items": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "artifacts_produced": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "purpose", "status"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["draft", "proposed", "verified", "rejected"] }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^EVID-\\d{4}$" }
    },
    "unresolved_risks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "conflicts_detected": {
      "type": "array",
      "items": { "type": "string", "pattern": "^CONF-\\d{4}$" }
    },
    "recommended_next_action": { "type": "string", "minLength": 1 },
    "context_pack_ref": { "type": ["string", "null"], "pattern": "^CPACK-\\d{4}$" },
    "git_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "branch", "head", "dirty", "changed_files"],
      "properties": {
        "available": { "type": "boolean" },
        "branch": { "type": ["string", "null"] },
        "head": { "type": ["string", "null"] },
        "dirty": { "type": "boolean" },
        "changed_files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "relevant_requirements": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "relevant_decisions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^ADR-\\d{4}$" }
    },
    "verified_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "status", "verified_by", "checks_summary"],
        "properties": {
          "id": { "type": "string", "pattern": "^EVID-\\d{4}$" },
          "path": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["verified"] },
          "verified_by": { "type": ["string", "null"] },
          "checks_summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unverified_claims": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "contradiction_warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "is_example": { "type": "boolean" },
    "example_notice": { "type": "string" }
  }
}
